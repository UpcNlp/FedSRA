"""
ablation_components_v2.py - Norm 版消融
======================================
6 个 variant (不再提 FM):
  A: ETF only (client avg, naive)
  B: Expert only
  C: ETF + Expert (client avg)
  D: ETF only (znorm+sqrt(n))
  F: Full = znorm + Expert (Ours)
  G: w/o ETF (CE backbone + znorm)  <- 用 ablation_fm_only 改

用法:
  python ablation_components_v2.py --alpha 0.05 --dataset cifar10 --seed 42
  python ablation_components_v2.py --alpha 0.05 --dataset cifar100 --seed 42

结果保存到 results/ablation_v2_{dataset}_a{alpha}_s{seed}.json
"""
import torch, torch.nn as nn, torch.nn.functional as F
import numpy as np, json, time, os, argparse
from rebuild8 import (
    device, USE_BF16,
    generate_etf, ConditionalExpert,
    prepare_data, train_bb, train_experts,
    cross_client_per_client_logits, expert_original
)
# === DongShou ablation: override DL_KWARGS for fast dataloader ===
import rebuild8
rebuild8.DL_KWARGS = dict(num_workers=4, pin_memory=True, persistent_workers=False)
print(f"  [Ablation] DL_KWARGS overridden: num_workers=4")
from resnet18_filter_merge import ResNet18Backbone


def precompute_with_union(bbs, client_exps, tl, etf, ccc, nc, union_method='znorm'):
    """评估时计算 errors + union_logits

    union_method: 'avg' (client 平均) 或 'znorm' (znorm+sqrt(n))
    """
    ed = etf.to(device)
    fd = etf.size(1)
    NC = len(bbs)

    # 先 forward 一次拿 features
    all_raw = []; all_labels = []
    N_total = 0

    # Determine N from test loader
    for _, _ in tl: pass
    N = sum(y.size(0) for _, y in tl)
    errors = torch.full((NC, N, nc), float('inf'))

    for k in range(NC):
        if bbs[k] is None: all_raw.append(None); continue
        bbs[k] = bbs[k].to(device); bbs[k].eval()
        for c in client_exps[k]:
            client_exps[k][c] = client_exps[k][c].to(device)
        feats = []; offset = 0
        with torch.no_grad():
            for x, y in tl:
                x = x.to(device); bs = x.size(0)
                feat = bbs[k](x)
                feats.append(feat.cpu())
                f_norm = F.normalize(feat, dim=1)
                for c, exp in client_exps[k].items():
                    fr, _ = exp(f_norm, ed[c].unsqueeze(0).expand(bs, -1))
                    errors[k, offset:offset+bs, c] = ((f_norm - fr)**2).mean(1).cpu()
                if k == 0: all_labels.append(y)
                offset += bs
        all_raw.append(torch.cat(feats, 0))
        bbs[k] = bbs[k].cpu()
        for c in client_exps[k]: client_exps[k][c] = client_exps[k][c].cpu()
        torch.cuda.empty_cache()
    labels = torch.cat(all_labels).numpy()

    sample_count = {}
    for k in range(NC):
        for c in client_exps[k]:
            sample_count[(k, c)] = ccc.get(k, {}).get(c, 0)

    # 算 union_logits (两种方式)
    if union_method == 'znorm':
        # znorm + sqrt(n)
        feat = torch.zeros(N, fd); w_sum = 0
        for k in range(NC):
            if all_raw[k] is None: continue
            f = all_raw[k]
            f_z = (f - f.mean(0, keepdim=True)) / (f.std(0, keepdim=True) + 1e-8)
            w = np.sqrt(sum(ccc.get(k, {}).values()))
            feat += f_z * w; w_sum += w
        feat_n = F.normalize(feat / w_sum, dim=1)
        union_logits = feat_n @ etf.T
    elif union_method == 'avg':
        # naive client avg of ETF logits
        all_logits = []
        for k in range(NC):
            if all_raw[k] is None: continue
            f = all_raw[k]
            logits_k = f @ etf.T
            all_logits.append(logits_k)
        union_logits = torch.stack(all_logits).mean(dim=0)
    else:
        raise ValueError(f"Unknown union_method: {union_method}")

    union_preds = union_logits.argmax(1).numpy()
    sl, _ = union_logits.sort(dim=1, descending=True)

    data = {
        'errors': errors, 'union_logits': union_logits,
        'union_preds': union_preds,
        'union_margin': (sl[:, 0] - sl[:, 1]).numpy(),
        'labels': labels, 'sample_count': sample_count,
        'K': NC, 'N': N, 'nc': nc,
    }
    return data


def evaluate_configs_v2(bbs, client_exps, tl, etf, ccc, nc):
    """评估 6 个 variant"""
    results = {}

    # === precompute 两次,一次 avg union,一次 znorm union ===
    print("  Precompute (avg union)...")
    data_avg = precompute_with_union(bbs, client_exps, tl, etf, ccc, nc, 'avg')
    print("  Precompute (znorm union)...")
    data_znorm = precompute_with_union(bbs, client_exps, tl, etf, ccc, nc, 'znorm')

    labels = data_avg['labels']

    # ─── A: ETF only (client avg, naive) ───
    preds = data_avg['union_logits'].argmax(1).numpy()
    results['A_rel_only_avg'] = float((preds == labels).mean())

    # ─── B: Expert only ───
    preds = expert_original(data_avg)
    results['B_expert_only'] = float((preds == labels).mean())

    # ─── C: Rel + Expert (client avg) ───
    best_acc = 0; best_cfg = ''
    for a in [0.3, 0.5, 1.0]:
        for mn in [0, 10]:
            preds = cross_client_per_client_logits(data_avg, alpha=a, min_n=mn)
            acc = float((preds == labels).mean())
            if acc > best_acc: best_acc = acc; best_cfg = f'α={a} n>={mn}'
    results['C_rel_expert_avg'] = best_acc
    results['C_rel_expert_avg_cfg'] = best_cfg

    # ─── D: ETF only (znorm+sqrt(n)) ───
    preds = data_znorm['union_logits'].argmax(1).numpy()
    results['D_rel_only_znorm'] = float((preds == labels).mean())

    # ─── F: Full (znorm + Expert + Fusion, Ours) ───
    best_acc = 0; best_cfg = ''
    for a in [0.3, 0.5, 1.0]:
        for mn in [0, 10]:
            preds = cross_client_per_client_logits(data_znorm, alpha=a, min_n=mn)
            acc = float((preds == labels).mean())
            if acc > best_acc: best_acc = acc; best_cfg = f'α={a} n>={mn}'
    results['F_full_ours'] = best_acc
    results['F_full_ours_cfg'] = best_cfg

    return results


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--alpha', type=float, default=0.05)
    parser.add_argument('--dataset', type=str, default='cifar10',
                        choices=['cifar10', 'cifar100'])
    parser.add_argument('--seed', type=int, default=42)
    args = parser.parse_args()

    torch.manual_seed(args.seed); np.random.seed(args.seed)
    if torch.cuda.is_available(): torch.cuda.manual_seed_all(args.seed)

    if args.dataset == 'cifar10':
        NC=5; NL=10; FD=256; LD=32; EPB=600; EPE=600
        cal, ccl, tl, ccc = prepare_data(NC, args.alpha, NL)
    else:
        from rebuild8_cifar100 import prepare_data_cifar100, train_experts_cifar100
        NC=5; NL=100; FD=256; LD=32; EPB=300; EPE=200
        cal, ccl, tl, ccc = prepare_data_cifar100(NC, args.alpha, NL)

    print(f"\n{'='*70}")
    print(f"  Norm 版 Ablation: {args.dataset} α={args.alpha} seed={args.seed}")
    print(f"{'='*70}")

    os.makedirs('results', exist_ok=True)
    etf = generate_etf(NL, FD)

    # ── 训练 (A/B/C/D/F 共享同一组 backbone+expert) ──
    print(f"\n训练...")
    bbs = []; client_exps = []; t0 = time.time()
    for k in range(NC):
        cls = sorted(ccc[k].keys())
        print(f"  Client {k}: {len(cls)} cls, {sum(ccc[k].values())} samp")
        bb = ResNet18Backbone(FD)
        bb = train_bb(bb, cal[k], cls, etf, EPB)
        if args.dataset == 'cifar10':
            exps = train_experts(bb, ccl[k], cls, etf, NL, FD, LD, EPE)
        else:
            exps = train_experts_cifar100(bb, ccl[k], cls, etf, ccc[k], NL, FD, LD, EPE)
        bbs.append(bb); client_exps.append(exps)
        if torch.cuda.is_available(): torch.cuda.empty_cache()
    tt = time.time() - t0
    print(f"训练耗时: {tt:.0f}s")

    # ── 评估 ──
    print(f"\n评估消融配置...")
    results = evaluate_configs_v2(bbs, client_exps, tl, etf, ccc, NL)

    # ── 输出 ──
    print(f"\n{'='*70}")
    print(f"  Norm 版消融结果 ({args.dataset} α={args.alpha})")
    print(f"{'='*70}")
    for cfg, acc in results.items():
        if isinstance(acc, float):
            print(f"  {cfg:<35s} {acc:>7.2%}")
        else:
            print(f"  {cfg:<35s} {acc}")

    out = {
        'dataset': args.dataset,
        'alpha': args.alpha,
        'seed': args.seed,
        'n_clients': NC,
        'train_time': tt,
        'results': results,
    }
    json.dump(out, open(f'results/ablation_v2_{args.dataset}_a{args.alpha}_s{args.seed}.json', 'w'), indent=2)
    print(f"\n  已保存: results/ablation_v2_{args.dataset}_a{args.alpha}_s{args.seed}.json")

if __name__ == '__main__':
    main()
